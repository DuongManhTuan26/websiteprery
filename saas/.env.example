# Copy to `.env` in this directory (saas/) before running
# `docker compose up --build`. docker compose automatically reads a
# sibling `.env` file for variable substitution in docker-compose.yml.

POSTGRES_PASSWORD=change-me-in-production

# Generate real secrets, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-byte-hex-string
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

# Must be the origin the browser actually loads the dashboard from.
DASHBOARD_ORIGIN=http://localhost:8080

# Must be an origin the *browser* can reach — baked into the frontend build,
# not read at container runtime (Vite env vars are compile-time).
VITE_API_URL=http://localhost:4000
