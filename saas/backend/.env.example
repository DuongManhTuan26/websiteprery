NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://saas_app:saas_dev_password@localhost:5432/saas_dev

# Generate real secrets for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-byte-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Required once the settings/API-key module is in use (AES-256-GCM key, 32 bytes)
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

DASHBOARD_ORIGIN=http://localhost:5173
