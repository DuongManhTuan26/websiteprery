# Copy to .env and fill in real values. Nothing in this repo works with
# fabricated/placeholder secrets — see saas/README.md for what each one
# actually requires and how to obtain it.

NODE_ENV=development
PORT=4000

# Local Postgres started via `saas/backend/scripts/dev-db.sh` uses this by
# default; point at a managed instance (RDS/Supabase/Neon/...) in production.
DATABASE_URL=postgresql://localhost:5432/preny_clone

# Any long random strings — used to sign JWTs. Rotate for production;
# rotating invalidates all existing sessions.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Must match the frontend's real origin (credentials: true cookies require
# an exact match, not a wildcard).
CORS_ORIGIN=http://localhost:5173

# Real key from https://console.anthropic.com — required for the chatbot to
# generate real replies. Left unset, /api/widget/message and the Facebook
# webhook still work end-to-end but the bot step is skipped with a visible
# "AI provider not configured" event instead of a fabricated reply.
ANTHROPIC_API_KEY=

# Real values from a real Meta App (developers.facebook.com) with the
# Messenger product added. Required for /api/fanpages/connect/facebook and
# the /api/webhooks/facebook signature check to do anything; without them
# those endpoints return a clear 501/403 rather than pretending to work.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
