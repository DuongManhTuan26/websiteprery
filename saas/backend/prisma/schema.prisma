// Domain model derived from the real, observed feature set of https://preny.ai/
// (see /saas/README.md "Product spec derived from observation" for the source
// evidence — captured content sections, nav, form fields). Everything below
// backend/database/API is original design, not reverse-engineered — preny.ai's
// actual schema/implementation is not accessible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum FanpageProvider {
  FACEBOOK
}

enum FanpageStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ChatbotStatus {
  ACTIVE
  PAUSED
}

enum ConversationChannel {
  FACEBOOK
  WIDGET
}

enum ConversationStatus {
  BOT
  HUMAN
  CLOSED
}

enum SenderType {
  CUSTOMER
  BOT
  AGENT
}

enum MessageContentType {
  TEXT
  IMAGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

// One signed-up business ("Đăng ký" on the marketing site). Owns everything
// else — fanpages, chatbots, customers, conversations — so the product
// supports multiple team members (User) per business from day one.
model Account {
  id            String   @id @default(uuid())
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  fanpages      Fanpage[]
  chatbots      Chatbot[]
  customers     Customer[]
  conversations Conversation[]
  orders        Order[]
  subscriptions Subscription[]
  products      Product[]

  @@map("accounts")
}

model User {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  // Separate from `role` on purpose: `role` (OWNER/ADMIN/AGENT) is scoped
  // to this user's own Account. isPlatformAdmin identifies the preny-clone
  // *operator* team — the only actors allowed to browse the Lead table
  // (see admin.routes.js), which belongs to the platform, not any tenant.
  // Never set through the public /api/auth/register flow — only via
  // scripts/promote-admin.js, run manually against a trusted database
  // connection.
  isPlatformAdmin Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  assignedThreads Conversation[] @relation("AssignedAgent")

  @@map("users")
}

// Supports refresh-token rotation for JWT auth (see src/lib/jwt.js).
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// "Tích hợp vào Fanpage" — a connected Facebook Page. accessToken is the
// Page Access Token returned by Facebook OAuth; real values only ever come
// from a real Meta App flow (see src/services/facebook.service.js) — never
// fabricated.
model Fanpage {
  id          String          @id @default(uuid())
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider    FanpageProvider @default(FACEBOOK)
  pageId      String          @unique
  pageName    String
  accessToken String
  status      FanpageStatus   @default(CONNECTED)
  connectedAt DateTime        @default(now())

  conversations Conversation[]

  @@map("fanpages")
}

// "AI Chatbot tư vấn sản phẩm" — one configurable bot per account (a
// business could run more than one, e.g. per product line).
model Chatbot {
  id           String        @id @default(uuid())
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  systemPrompt String        @db.Text
  aiProvider   String        @default("anthropic")
  aiModel      String        @default("claude-sonnet-5")
  status       ChatbotStatus @default(ACTIVE)
  // Public, non-secret identifier embedded in the website widget snippet
  // (see /saas/frontend/widget) — safe to expose in client-side HTML,
  // unlike accountId/userId which are only ever used behind requireAuth.
  widgetKey    String        @unique @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  conversations Conversation[]

  @@map("chatbots")
}

// "AI Chatbot tư vấn sản phẩm trực quan qua hình ảnh... khách yêu cầu xem
// ảnh AI cũng sẽ gửi" — for the bot to send back a real product image, it
// needs a real catalog to look one up in; this was missing from the
// original schema draft and is added here rather than left unbuilt.
model Product {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  imageUrl    String?
  price       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// "Mọi thông tin khách hàng được tự động ghi nhận... vào mini CRM" — auto
// created/updated the first time a given Facebook PSID (or widget visitor)
// messages in; never requires the business to type it in by hand.
model Customer {
  id            String   @id @default(uuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String?
  phone         String?
  email         String?
  facebookPsid  String?
  tags          String[] @default([])
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations Conversation[]
  orders        Order[]

  @@unique([accountId, facebookPsid])
  @@map("customers")
}

// "Tập trung toàn bộ hội thoại bán hàng... vào một giao diện duy nhất" — one
// thread per customer per channel. `status` implements the documented
// bot→human handoff.
model Conversation {
  id             String              @id @default(uuid())
  accountId      String
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fanpageId      String?
  fanpage        Fanpage?            @relation(fields: [fanpageId], references: [id])
  chatbotId      String?
  chatbot        Chatbot?            @relation(fields: [chatbotId], references: [id])
  channel        ConversationChannel
  status         ConversationStatus  @default(BOT)
  assignedUserId String?
  assignedUser   User?               @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  createdAt      DateTime            @default(now())
  lastMessageAt  DateTime            @default(now())

  messages Message[]
  orders   Order[]

  @@map("conversations")
}

// "khách gửi AI tư vấn được ảnh và khách yêu cầu xem ảnh AI cũng sẽ gửi" —
// contentType=IMAGE covers both directions.
model Message {
  id             String             @id @default(uuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType
  contentType    MessageContentType @default(TEXT)
  content        String?            @db.Text
  imageUrl       String?
  createdAt      DateTime           @default(now())

  @@map("messages")
}

// "chốt đơn" — an order/deal a conversation resulted in.
model Order {
  id             String       @id @default(uuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  productName    String
  quantity       Int          @default(1)
  amount         Decimal      @db.Decimal(12, 2)
  status         OrderStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("orders")
}

// The public marketing site's real contact form (5 real captured fields:
// two unlabeled text inputs, username, phone, category) — a pre-signup
// demo/trial request, not yet an Account.
model Lead {
  id         String     @id @default(uuid())
  fullName   String?
  username   String?
  phone      String?
  category   String?
  source     String     @default("website")
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  @@map("leads")
}

// "Bảng giá" — subscription plans/billing, standard SaaS shape.
model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  priceMonthly    Decimal  @db.Decimal(12, 2)
  maxFanpages     Int
  maxChatbots     Int
  maxConversations Int
  createdAt       DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String              @id @default(uuid())
  accountId        String
  account          Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan                @relation(fields: [planId], references: [id])
  status           SubscriptionStatus  @default(TRIALING)
  currentPeriodEnd DateTime
  createdAt        DateTime            @default(now())

  @@map("subscriptions")
}
