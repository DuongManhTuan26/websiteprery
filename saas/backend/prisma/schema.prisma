// Prisma schema — grows incrementally, one migration per phase (see
// ../../ARCHITECTURE.md "Data model"). This phase (database + migrations)
// introduces only the root User entity; auth-specific tables (RefreshToken)
// are added in the auth phase's own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]

  @@map("users")
}

// Refresh tokens are stored as a SHA-256 hash, never plaintext — a DB leak
// alone doesn't let an attacker mint sessions. Rotated on every use (the old
// row is revoked, a new one issued) so a stolen-then-reused token is
// detectable (revokedAt already set) rather than silently accepted forever.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// The tenant boundary. Every tenant-owned entity added in later phases
// (Chatbot, Contact, ...) carries a workspaceId and is only ever reachable
// through a route guarded by requireWorkspaceMember.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  chatbots Chatbot[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// Which AI backend replies for a given chatbot. MOCK is deterministic and
// needs no external credentials — the default so the system is runnable and
// testable with zero setup; OPENAI is a real, optional integration (see the
// ai-providers module) enabled per-chatbot once a workspace has configured
// an API key.
enum AIProviderType {
  MOCK
  OPENAI
}

model Chatbot {
  id           String         @id @default(uuid())
  workspaceId  String
  name         String
  systemPrompt String         @default("You are a helpful assistant.")
  aiProvider   AIProviderType @default(MOCK)
  aiModel      String?
  widgetToken  String         @unique @default(uuid())
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId])
  @@map("chatbots")
}

// Real, server-persisted conversation history — replaces the widget's
// earlier client-supplied `history` array entirely (that array was a
// stopgap for the widget phase, before this model existed; trusting the
// server's own stored messages instead of whatever a client claims its
// history was is both more correct and removes a prompt-injection surface,
// see widget/service.ts). contactId (mini CRM) is added in that phase's own
// migration rather than forward-referencing a model that doesn't exist yet.
model Conversation {
  id        String   @id @default(uuid())
  chatbotId String
  channel   String   @default("widget")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatbot  Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([chatbotId])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}
