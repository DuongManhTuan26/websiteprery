// Prisma schema — grows incrementally, one migration per phase (see
// ../../ARCHITECTURE.md "Data model"). This phase (database + migrations)
// introduces only the root User entity; auth-specific tables (RefreshToken)
// are added in the auth phase's own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
