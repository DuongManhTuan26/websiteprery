// Prisma schema — grows incrementally, one migration per phase (see
// ../../ARCHITECTURE.md "Data model"). This phase (database + migrations)
// introduces only the root User entity; auth-specific tables (RefreshToken)
// are added in the auth phase's own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]

  @@map("users")
}

// Refresh tokens are stored as a SHA-256 hash, never plaintext — a DB leak
// alone doesn't let an attacker mint sessions. Rotated on every use (the old
// row is revoked, a new one issued) so a stolen-then-reused token is
// detectable (revokedAt already set) rather than silently accepted forever.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// The tenant boundary. Every tenant-owned entity added in later phases
// (Chatbot, Contact, ...) carries a workspaceId and is only ever reachable
// through a route guarded by requireWorkspaceMember.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}
